# Runtime environment (no secrets in git — real values live in Vercel env vars / local .env)

# Persistence seam: free-tier hosted KV (values provided by the KV provider)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI adapter (OFF by default; set AI_ENABLED=true plus a key for live candidates)
AI_ENABLED=
OPENCODE_API_KEY=
# Optional overrides for the OpenAI-compatible endpoint
AI_BASE_URL=
AI_MODEL=
# Reasoning effort: low | high | max
AI_EFFORT=
# Optional failover endpoint tried once after a transport failure
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=

# Developer-only surfaces (/dev page + /api/dev/*); leave empty to disable all
# dev routes (they fail closed: unset key is indistinguishable from a wrong one)
ADMIN_KEY=

# Tenant store (Supabase Postgres, ca-central-1). The Postgres tenant path runs
# ONLY when TENANT_STORE=postgres; while it stays empty the app keeps the
# legacy KV (Upstash) path and shows a "database not configured" notice — it
# degrades, it does not crash.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Sign-in surface (ticket #54). All OFF by default: with these unset the app
# keeps the workspace-key path and the sign-in page says "sign-in is not
# configured" (a 503 notice, never a crash).
SUPABASE_AUTH_ENABLED=
SUPABASE_AUTH_EMAIL_ENABLED=
SUPABASE_AUTH_GOOGLE_ENABLED=
SUPABASE_AUTH_MICROSOFT_ENABLED=
# Absolute app origin used to build the OAuth and email-invitation redirects
# (required for Google/Microsoft and for accepting an email invitation);
# e.g. https://auditor.example.
SUPABASE_AUTH_REDIRECT_ORIGIN=
# The cutover switch: "postgres" enables the Postgres tenant path, empty
# keeps the legacy KV path (whatever POSTGRES_URL says).
TENANT_STORE=
# The pooled connection string the app actually uses: the auditorai_app role.
TENANT_POSTGRES_URL=
# Platform-injected owner credentials (the platform links the Supabase
# project). The app NEVER reads this one: the owner bypasses RLS.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# Platform-injected by the Postgres provider; no in-repo consumer — adopting an
# ORM is out of scope for this ticket.
POSTGRES_PRISMA_URL=
