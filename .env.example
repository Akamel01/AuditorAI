# Runtime environment (no secrets in git — real values live in Vercel env vars / local .env)

# Persistence seam: free-tier hosted KV (values provided by the KV provider)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI adapter (OFF by default; set AI_ENABLED=true plus a key for live candidates)
AI_ENABLED=
OPENCODE_API_KEY=
# Optional overrides for the OpenAI-compatible endpoint
AI_BASE_URL=
AI_MODEL=
# Reasoning effort: low | high | max
AI_EFFORT=
# Optional failover endpoint tried once after a transport failure
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=

# Developer-only surfaces (/dev page + /api/dev/*); leave empty to disable all
# dev routes (they fail closed: unset key is indistinguishable from a wrong one)
ADMIN_KEY=
