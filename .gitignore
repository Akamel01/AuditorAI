# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/

# Testing
coverage/

# Stale .ts twin build output (loop-4 T4): src/tests are TS-only; ignore
# compiled twins shadowing .ts under vitest/eslint. Scoped — must NOT hide
# root configs (next.config.js, playwright.config.js) or scripts/*.js.
src/**/*.js
tests/**/*.js
src/**/*.jsx
tests/**/*.jsx

# Environment & secrets
.env
.env.*
!.env.example

# Framework / platform
.vercel/
.netlify/

# Logs
*.log
npm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Local scratch (never project state)
tmp/

# Candidate outcome log (ADR-0009): raw auditor work products never enter git.
state/candidate-outcomes/

# TypeScript incremental build info
tsconfig.tsbuildinfo
.vercel
.env*

# AutoForge staging (R12 curated: keep state + discovery + architecture + plans + reviews + validation, ignore ephemeral)
.autoforge/*
!.autoforge/AGENTS.md
!.autoforge/state.json
!.autoforge/discovery/
!.autoforge/discovery/**
!.autoforge/architecture/
!.autoforge/architecture/**
!.autoforge/plans/
!.autoforge/plans/**
!.autoforge/requirements/
!.autoforge/requirements/**
!.autoforge/execution/
!.autoforge/execution/**
!.autoforge/reviews/
!.autoforge/reviews/**
!.autoforge/validation/
!.autoforge/validation/**
