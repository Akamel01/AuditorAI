{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditorai.dev/schemas/attachment.schema.json",
  "title": "Attachment",
  "description": "One pasted/uploaded drawing stored inline as a data-URL (M1 decision: <=500KB/image, <=12/project, PNG/JPEG/WebP).",
  "type": "object",
  "required": [
    "attachment_id",
    "project_id",
    "input_id",
    "file_name",
    "mime",
    "bytes",
    "data_url",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "attachment_id": { "type": "string", "pattern": "^ATT-[A-Za-z0-9_-]+$" },
    "project_id": { "type": "string" },
    "input_id": { "type": ["string", "null"] },
    "file_name": { "type": "string", "minLength": 1 },
    "mime": { "enum": ["image/png", "image/jpeg", "image/webp"] },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 500000 },
    "data_url": {
      "type": "string",
      "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$"
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
