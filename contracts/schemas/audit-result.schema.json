{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditorai.dev/schemas/audit-result.schema.json",
  "title": "AuditResult",
  "description": "Deterministic output of one audit run (§19). Findings reuse finding.schema.json.",
  "type": "object",
  "required": [
    "audit_id",
    "project_id",
    "jurisdiction",
    "framework_name",
    "native_stage_id",
    "native_stage_display_name",
    "canonical_stages",
    "mapping_confidence",
    "ran_at",
    "input_manifest",
    "findings",
    "missing_information",
    "audit_questions",
    "limitations",
    "disclaimer"
  ],
  "additionalProperties": false,
  "properties": {
    "audit_id": { "type": "string" },
    "project_id": { "type": "string" },
    "jurisdiction": { "enum": ["INT", "UK", "US", "CA", "AE"] },
    "framework_name": { "type": "string" },
    "native_stage_id": { "type": "string", "pattern": "^[a-z]{2,8}(-[a-z0-9]+)*:[A-Za-z0-9_-]+$" },
    "native_stage_display_name": { "type": "string" },
    "canonical_stages": {
      "type": "array",
      "items": {
        "enum": ["FEASIBILITY_CONCEPT", "PRELIMINARY_DESIGN", "DETAILED_DESIGN"]
      }
    },
    "mapping_confidence": { "enum": ["authoritative", "interpreted", "inferred"] },
    "ran_at": { "type": "string", "format": "date-time" },
    "input_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "label",
          "requirement_level",
          "state",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "input_id": { "type": "string" },
          "label": { "type": "string" },
          "requirement_level": { "enum": ["required", "recommended", "optional", "unknown"] },
          "state": {
            "enum": [
              "provided",
              "required_missing",
              "recommended_missing",
              "optional_missing",
              "unknown",
              "not_applicable",
              "not_available",
              "conflicting"
            ]
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "https://auditorai.dev/schemas/finding.schema.json" }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "input_id",
          "label",
          "requirement_level",
          "note",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string" },
          "input_id": { "type": "string" },
          "label": { "type": "string" },
          "requirement_level": { "enum": ["required", "recommended", "optional", "unknown"] },
          "note": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "audit_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "text",
          "topic",
          "applies_to_canonical",
          "road_users",
          "source_note",
          "addressed"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string" },
          "text": { "type": "string" },
          "topic": { "type": "string" },
          "applies_to_canonical": {
            "type": "array",
            "items": {
              "enum": ["FEASIBILITY_CONCEPT", "PRELIMINARY_DESIGN", "DETAILED_DESIGN"]
            }
          },
          "road_users": { "type": "array", "items": { "type": "string" } },
          "source_note": { "type": ["string", "null"] },
          "addressed": { "type": "boolean" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "disclaimer": { "type": "string", "minLength": 1 }
  }
}
