{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Project Package (assembly record)",
  "type": "object",
  "required": ["package_id", "match_id", "metadata", "inputs", "outputs", "completeness"],
  "additionalProperties": false,
  "properties": {
    "package_id": { "type": "string", "pattern": "^PKG-[A-Za-z0-9-]+$" },
    "match_id": { "type": "string", "pattern": "^MAT-[A-Za-z0-9-]+$" },
    "metadata": {
      "type": "object",
      "required": ["title", "source_urls"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "scheme_summary": { "type": ["string", "null"] },
        "authority_hint": { "type": ["string", "null"] },
        "location_hint": { "type": ["string", "null"] },
        "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["drawing_doc_ids", "other_doc_ids"],
      "additionalProperties": false,
      "properties": {
        "drawing_doc_ids": { "type": "array", "items": { "type": "string", "pattern": "^DOC-[A-Za-z0-9-]+$" } },
        "other_doc_ids": { "type": "array", "items": { "type": "string", "pattern": "^DOC-[A-Za-z0-9-]+$" } }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["rsa_report_doc_ids", "checklist_doc_ids", "designer_response_doc_ids"],
      "additionalProperties": false,
      "properties": {
        "rsa_report_doc_ids": { "type": "array", "items": { "type": "string", "pattern": "^DOC-[A-Za-z0-9-]+$" } },
        "checklist_doc_ids": { "type": "array", "items": { "type": "string", "pattern": "^DOC-[A-Za-z0-9-]+$" } },
        "designer_response_doc_ids": { "type": "array", "items": { "type": "string", "pattern": "^DOC-[A-Za-z0-9-]+$" } }
      }
    },
    "completeness": {
      "enum": ["full-package", "outputs-only", "inputs-only", "excerpt", "unassigned"]
    }
  }
}
