{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODD declaration (ADR-0005 / DEC-0006)",
  "type": "object",
  "required": ["schema_version", "declaration_version", "date", "adr_ref", "_notes", "cells"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "declaration_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "adr_ref": { "type": "string" },
    "decision_ref": { "type": "string" },
    "_notes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "jurisdiction_id",
          "framework_id",
          "native_stage_id",
          "canonical_stage",
          "mapping_confidence",
          "status",
          "fixture_ids",
          "incident_flags",
          "input_floor",
          "scheme_scope_note"
        ],
        "additionalProperties": false,
        "properties": {
          "jurisdiction_id": {
            "enum": ["international", "uk", "usa", "canada", "uae"]
          },
          "framework_id": { "type": "string" },
          "native_stage_id": { "type": ["string", "null"] },
          "canonical_stage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["FEASIBILITY_CONCEPT", "PRELIMINARY_DESIGN", "DETAILED_DESIGN"]
            }
          },
          "mapping_confidence": {
            "type": ["string", "null"],
            "enum": ["authoritative", "interpreted", "inferred", null]
          },
          "status": { "enum": ["in", "mapped_unproven", "structurally_absent"] },
          "fixture_ids": { "type": "array", "items": { "type": "string" } },
          "incident_flags": { "type": "array", "items": { "type": "string" } },
          "input_floor": { "type": "array", "items": { "type": "string" } },
          "scheme_scope_note": { "type": "string" }
        }
      }
    }
  }
}
