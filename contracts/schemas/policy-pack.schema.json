{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditorai.dev/schemas/policy-pack.schema.json",
  "title": "AuditorAI Policy Pack",
  "description": "Versioned machine-readable jurisdiction knowledge. Every normative item cites evidence registry ids. Validated with ajv.",
  "type": "object",
  "required": [
    "schema_version",
    "pack_version",
    "jurisdiction",
    "framework",
    "stages",
    "exceptions",
    "inputs",
    "outputs",
    "audit_questions",
    "rules",
    "road_user_categories",
    "issue_categories",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "pack_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "jurisdiction": { "enum": ["INT", "UK", "US", "CA", "AE"] },
    "jurisdiction_label": { "type": "string" },
    "framework": {
      "type": "object",
      "required": ["name", "publisher", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "publisher": { "type": "string" },
        "revision": { "type": ["string", "null"] },
        "publication_date": { "type": ["string", "null"] },
        "status": {
          "enum": [
            "authoritative_current",
            "recommended_practice",
            "provincial_instruments",
            "qualified_baseline",
            "unknown_unavailable"
          ]
        },
        "qualification_note": { "type": "string" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "native_stage_id",
          "display_name",
          "definition",
          "trigger",
          "canonical_stages",
          "confidence",
          "mvp_scope",
          "order"
        ],
        "additionalProperties": false,
        "properties": {
          "native_stage_id": {
            "type": "string",
            "pattern": "^[a-z]{2,4}(-[a-z0-9]+)*:[A-Za-z0-9_]+$",
            "description": "Jurisdiction-namespaced; bare integers forbidden (ADR-0002)."
          },
          "display_name": { "type": "string" },
          "definition": { "type": "string" },
          "trigger": { "type": ["string", "null"] },
          "canonical_stages": {
            "type": "array",
            "items": {
              "enum": ["FEASIBILITY_CONCEPT", "PRELIMINARY_DESIGN", "DETAILED_DESIGN"]
            }
          },
          "confidence": { "enum": ["authoritative", "interpreted", "inferred"] },
          "mvp_scope": { "type": "boolean" },
          "order": { "type": "integer" },
          "notes": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exception_id", "kind", "condition", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "exception_id": { "type": "string" },
          "kind": {
            "enum": [
              "combined_audit",
              "interim_audit_not_a_stage",
              "no_native_equivalent",
              "named_phase_not_numbered_stage"
            ]
          },
          "spans_native_stage_ids": { "type": "array", "items": { "type": "string" } },
          "condition": { "type": "string" },
          "alternative": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "stage_ids",
          "label",
          "requirement_level",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "input_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "stage_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "requirement_level": {
            "enum": ["required", "recommended", "optional", "unknown"]
          },
          "conditional_on": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["output_id", "stage_ids", "label", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "output_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "stage_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "requirement_level": {
            "enum": ["required", "recommended", "optional", "unknown"]
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "audit_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "text", "applies_to_canonical", "topic"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string" },
          "text": { "type": "string" },
          "topic": { "type": "string" },
          "applies_to_canonical": {
            "type": "array",
            "items": {
              "enum": ["FEASIBILITY_CONCEPT", "PRELIMINARY_DESIGN", "DETAILED_DESIGN"]
            }
          },
          "road_users": { "type": "array", "items": { "type": "string" } },
          "source_note": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "kind", "description", "effects", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": "string" },
          "kind": { "enum": ["completeness", "process", "eligibility", "output_discipline"] },
          "description": { "type": "string" },
          "applies_to_native_stage_ids": { "type": "array", "items": { "type": "string" } },
          "requires_input_ids": { "type": "array", "items": { "type": "string" } },
          "effects": {
            "type": "object",
            "required": ["finding_kind"],
            "additionalProperties": false,
            "properties": {
              "finding_kind": {
                "enum": ["missing_information", "process_gap", "not_eligible", "recommendation_wording"]
              }
            }
          },
          "severity_hint": {
            "enum": ["none", "low", "medium", "high", null]
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "road_user_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "issue_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "publisher"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "revision": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"] },
          "accessed": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
