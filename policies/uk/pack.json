    { "question_id": "uk-q-signage-markings-lighting", "text": "Are signs, markings, lighting and street furniture located and designed so they inform without obscuring or creating hazards (including darkness conditions)?", "topic": "signage_markings_lighting", "applies_to_canonical": ["DETAILED_DESIGN"], "road_users": [], "source_note": "Appendix B checklist themes [EV-UK-002]" },
