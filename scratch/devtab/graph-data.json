{
  "nodes": [
    { "id": "AG-PROJECT", "name": "Project Intake", "class": "deterministic", "emits": "project.record", "depends_on": [], "executed_in_batch": true, "summary": "Copies the stored Project record into the pipeline verbatim." },
    { "id": "AG-STAGE-SELECT", "name": "Stage Resolution & Eligibility", "class": "deterministic", "emits": "context.snapshot", "depends_on": ["AG-PROJECT"], "executed_in_batch": true, "summary": "Jurisdiction→Framework→NativeStage resolution with eligibility checks." },
    { "id": "AG-MANIFEST", "name": "Input Manifest", "class": "deterministic", "emits": "manifest.table", "depends_on": ["AG-STAGE-SELECT"], "executed_in_batch": true, "summary": "Input normalization to §14/§27 states for the selected native stage." },
    { "id": "AG-RULES", "name": "Deterministic Rule Evaluation", "class": "deterministic", "emits": "rules.results", "depends_on": ["AG-MANIFEST"], "executed_in_batch": true, "summary": "Completeness/process/eligibility rules from the policy pack; no scores." },
    { "id": "AG-FINDINGS", "name": "Deterministic Findings Shaping", "class": "deterministic", "emits": "findings.deterministic", "depends_on": ["AG-RULES"], "executed_in_batch": true, "summary": "Gates raw rule outcomes into schema-valid draft findings." },
    { "id": "AG-QUESTIONS", "name": "Audit Question Selection", "class": "deterministic", "emits": "questions.set", "depends_on": ["AG-STAGE-SELECT"], "executed_in_batch": true, "summary": "Stage-relevant audit questions surfaced for human reasoning." },
    { "id": "AG-AI-CANDIDATES", "name": "AI Candidate Generation", "class": "ai-bounded", "emits": "candidates.ai", "depends_on": ["AG-QUESTIONS"], "executed_in_batch": true, "summary": "Bounded AI candidate findings via AiAdapter; OFF default = null slice." },
    { "id": "AG-ADJUDICATION", "name": "Human Adjudication", "class": "human", "emits": "adjudication.decisions", "depends_on": ["AG-FINDINGS", "AG-AI-CANDIDATES", "AG-QUESTIONS"], "executed_in_batch": true, "summary": "Human review workflow + wording discipline; batch carries drafts unverified." },
    { "id": "AG-EVIDENCE-LINKS", "name": "Evidence Linkset Validation", "class": "deterministic", "emits": "evidence.linkset", "depends_on": ["AG-RULES", "AG-ADJUDICATION"], "executed_in_batch": true, "summary": "Every normative claim traceable to evidence-registry ids." },
    { "id": "AG-REPORT", "name": "Report Assembly", "class": "deterministic", "emits": "report.bundle", "depends_on": ["AG-ADJUDICATION", "AG-EVIDENCE-LINKS"], "executed_in_batch": true, "summary": "Deterministic report assembly (JSON + Markdown)." },
    { "id": "AG-PERSIST", "name": "Persistence Receipt", "class": "deterministic", "emits": "persistence.receipt", "depends_on": ["AG-REPORT"], "executed_in_batch": false, "summary": "Versioned storage behind the DataStore seam; step-mode only." }
  ],
