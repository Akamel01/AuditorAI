        { "id": "D01-DISCOVER", "impl": "src/discovery/providers/* via src/discovery/pipeline.ts d01Discover", "role": "Portal/search fan-out through DiscoveryProvider seam (seed-portals offline; brave-search + google-cse secrets OFF default (env first, then Keychain auditorai/*))" },
        { "id": "D02-QUALIFY", "impl": "src/discovery/qualifier.ts qualifyHits", "role": "Deterministic in_scope/reserve/reject over hits (R1-R4 analogue); tier-1 licensed stays reserve pending owner approval" },
        { "id": "D03-MATCH", "impl": "src/discovery/matcher.ts matchQualified (reuses getPack + resolveOdd)", "role": "Jurisdiction/framework/native-stage assignment; structurally_absent refused; odd_status stamped" },
        { "id": "D04-ACQUIRE", "impl": "src/discovery/drawing.ts getDrawingProcessor + ctx.acquireDocs", "role": "PDF bytes + unpdf text/page extraction; pages recorded even when raster/OCR pending (nulls, never dropped)" },
        { "id": "D05-CLASSIFY", "impl": "src/discovery/classifier.ts classifyBundle", "role": "Keyword-ruleset doc roles; confidence <0.7 auto-reserve (owner decision), auto_reserved_doc_ids traced" },
        { "id": "D06-PACKAGE", "impl": "src/discovery/packager.ts assemblePackage", "role": "Assemble project-package record (inputs/drawings + outputs) with completeness vocabulary" },
        { "id": "D07-PROVENANCE", "impl": "src/discovery/provenance.ts writeProvenance", "role": "Byte-stable provenance.json chain: URLs -> sha256 -> extraction -> classifier version -> ODD cell" },
        { "id": "D08-QUALITY", "impl": "src/discovery/dedupe.ts checkDuplicate/claimFingerprints", "role": "Completeness + exact/near-dup verdicts against dedupe index; full-package+unknown licence flags owner review" },
        { "id": "D09-COVERAGE", "impl": "src/discovery/coverage.ts computeCoverage", "role": "ODD Coverage Score: 16-cell targets weighted by gap+risk vs TARGET_TOTAL=500; labels COVERED/UNDER/MISSING/OVER/EXCLUDED" },
        { "id": "D10-QUEUE", "impl": "src/discovery/coverage.ts buildQueue", "role": "Ranked discovery queue (gap_share x risk) feeding next D01 cycle — LOOP edge" }
