    "audit_graph": {
      "purpose": "Bounded-context graph the product executes to run an actual audit (\u00a719)",
      "nodes": [
        {
          "id": "AUD-PROJECT",
          "role": "Project + metadata + stage selection",
          "impl": "src/domain/types.ts (Project)"
        },
        {
          "id": "AUD-CONTEXT",
          "role": "Assemble Audit Context (jurisdiction/framework/native stage/inputs)",
          "impl": "src/domain/engine.ts buildAuditContext"
        },
        {
          "id": "AUD-MANIFEST",
          "role": "Input normalization: manifest + \u00a727 states",
          "impl": "engine.runAudit"
        },
        {
          "id": "AUD-EVIDENCE",
          "role": "Evidence selection/lookup with provenance",
          "impl": "src/lib/evidence.ts"
        },
        {
          "id": "AUD-RULES",
          "role": "Deterministic checks from policy pack",
          "impl": "engine.runAudit rules loop"
        },
        {
          "id": "AUD-QUESTIONS",
          "role": "Stage assessment questions for human reasoning",
          "impl": "engine.runAudit questions"
        },
        {
          "id": "AUD-AI-CANDIDATES",
          "role": "Bounded AI candidate findings (OFF by default)",
          "impl": "src/lib/ai.ts"
        },
        {
          "id": "AUD-ADJUDICATION",
          "role": "Human review: reviewer_status/recommendation; wording discipline",
          "impl": "PATCH /api/projects/:id/audits/:aid"
        },
        {
          "id": "AUD-REPORT",
          "role": "Report rendering JSON+Markdown+print-PDF",
          "impl": "src/lib/report.ts"
        },
        {
          "id": "AUD-FINALIZE",
          "role": "Final audit owned by qualified auditor/authority (out of software scope)",
          "impl": null
        }
      ],
      "edges": [
        {
          "from": "AUD-PROJECT",
          "type": "DATA",
          "to": "AUD-CONTEXT",
          "payload": "project record"
        },
        {
          "from": "AUD-CONTEXT",
          "type": "CONTRACT",
          "to": "AUD-MANIFEST",
          "payload": "policy pack stage definition"
        },
        {
          "from": "AUD-EVIDENCE",
          "type": "EVIDENCE",
          "to": "AUD-RULES",
          "payload": "evidence ids cited by rules"
        },
        {
          "from": "AUD-MANIFEST",
          "type": "DATA",
          "to": "AUD-RULES",
          "payload": "input states"
        },
        {
          "from": "AUD-RULES",
          "type": "DATA",
          "to": "AUD-ADJUDICATION",
          "payload": "draft compliance questions + missing information"
        },
        {
          "from": "AUD-QUESTIONS",
          "type": "CONTEXT",
          "to": "AUD-ADJUDICATION",
          "payload": "stage questions"
        },
        {
          "from": "AUD-AI-CANDIDATES",
          "type": "DATA",
